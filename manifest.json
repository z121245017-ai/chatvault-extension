{
  "manifest_version": 3,
  "name": "ChatVault - DeepSeek 对话导出 Markdown",
  "short_name": "ChatVault",
  "version": "1.1.0",
  "description": "把 DeepSeek 对话导出为 Markdown，保留思考过程、公式和代码块。导出前显示读取条数与完整性，不完整会明确标注。本地运行，不上传数据。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatVault - DeepSeek 对话导出",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "src/extractor/chat_extractor.js",
        "src/formatter/markdown_exporter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'none'; object-src 'none';"
  }
}
